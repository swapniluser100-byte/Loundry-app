{
  "name": "laundry-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for the Pune Laundry Management app (D1 + R2 + Resend/Brevo email)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply laundry_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply laundry_db --remote",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "hono": "^4.6.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
